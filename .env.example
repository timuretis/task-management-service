# Copy to .env. Never commit real values.
PORT=3000
NODE_ENV=development
# Comma-separated web origins allowed by CORS. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# Required. Matches the local database from docker-compose.yml (local-only password).
DATABASE_URL=postgres://tasks:tasks@127.0.0.1:5432/tasks
